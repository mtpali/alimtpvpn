<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
            android:insetLeft="6dp"
            android:insetTop="6dp"
            android:insetRight="6dp"
            android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#56565B" />
                <stroke
                    android:width="1dp"
                    android:color="#6A6A70" />
                <corners android:radius="22dp" />
                <padding
                    android:left="8dp"
                    android:top="2dp"
                    android:right="8dp"
                    android:bottom="2dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="6dp"
            android:insetTop="6dp"
            android:insetRight="6dp"
            android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#222226" />
                <stroke
                    android:width="1dp"
                    android:color="#34343A" />
                <corners android:radius="22dp" />
                <padding
                    android:left="8dp"
                    android:top="2dp"
                    android:right="8dp"
                    android:bottom="2dp" />
            </shape>
        </inset>
    </item>
</selector>
